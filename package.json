{
  "name": "typescript-nextjs-starter",
  "version": "1.0.0",
  "private": true,
  "description": "A TypeScript starter for Next.js that includes all you need to build amazing projects",
  "keywords": [
    "nextjs",
    "starter",
    "typescript"
  ],
  "license": "MIT",
  "author": "Ch1nhcp",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "next typegen && tsc --noEmit",
    "build:analyze": "next build && next experimental-analyze",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix --type-aware",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "format:ci": "oxfmt --list-different .",
    "postinstall": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit:performance": "node scripts/audit-performance.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tailwindcss/postcss": "4.3.2",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-query-devtools": "5.101.2",
    "babel-plugin-react-compiler": "1.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "fumadocs-core": "16.19.7",
    "fumadocs-mdx": "15.6.4",
    "lucide-react": "1.23.0",
    "next": "16.2.9",
    "next-intl": "4.13.1",
    "next-themes": "0.4.6",
    "postcss": "8.5.16",
    "radix-ui": "1.6.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.80.0",
    "shadcn": "4.12.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "25.9.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lighthouse": "13.6.0",
    "lint-staged": "17.0.8",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "oxlint-tsgolint": "0.24.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@11.9.0"
}
